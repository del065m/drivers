[Version]
Signature="$WINDOWS NT$"
Class=Keyboard
ClassGuid={4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer = 12/27/2025,13.8.54.849
CatalogFile=fkeyboard.cat

[Manufacturer]
%MfgName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=fkeyboard_Install, Root\FKeyboardFilter

[fkeyboard_Install.NT]
CopyFiles=DriverCopyFiles

[fkeyboard_Install.NT.Services]
AddService = fkeyboard, 0x00000002, fkeyboard_Service_Inst

[DriverCopyFiles]
fkeyboard.sys

[fkeyboard_Service_Inst]
DisplayName = %ServiceName%
ServiceType = 1 ; SERVICE_KERNEL_DRIVER
StartType = 3 ; SERVICE_DEMAND_START
ErrorControl = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\fkeyboard.sys

[SourceDisksNames]
1 = %DiskName%,,,\

[SourceDisksFiles]
fkeyboard.sys = 1

[DestinationDirs]
DriverCopyFiles = 12 ; System32\drivers

[Strings]
ProviderName = "test"
MfgName = "test"
DeviceDesc = "fkeyboard Filter Driver"
ServiceName = "fkeyboard"
DiskName = "fkeyboard Installation Disk"
